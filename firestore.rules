rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users — authenticated users read all, write only own profile
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Ads — anyone can read active ads, owner can update/delete own ads
    match /ads/{adId} {
      allow read: if true;
      // Create only through server-side Admin SDK (client create blocked)
      allow create: if false;
      // Update/delete: only ad owner (advertiserUID field)
      allow update, delete: if request.auth != null
        && request.auth.uid == resource.data.advertiserUID;
    }

    // Transactions — owner can read own, no client writes
    match /transactions/{txId} {
      allow read: if request.auth != null
        && request.auth.uid == resource.data.uid;
      allow write: if false;
    }

    // Waitlist — authenticated user can write own entry only
    match /waitlist/{email} {
      allow read: if false;
      allow create, update: if request.auth != null;
      allow delete: if false;
    }

    // Payments — only owner can read, no client writes
    match /payments/{paymentId} {
      allow read: if request.auth != null
        && request.auth.uid == resource.data.uid;
      allow write: if false;
    }

    // Categories — public read, no client writes
    match /categories/{catId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
