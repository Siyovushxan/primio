rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) { return request.auth != null && request.auth.uid == uid; }
    function admin() { return request.auth != null && request.auth.token.admin == true; }
    match /users/{uid} { allow read: if owner(uid) || admin(); allow write: if false; }
    match /ads/{id} { allow read: if owner(resource.data.advertiserUID) || admin(); allow write: if false; }
    match /transactions/{id} { allow read: if owner(resource.data.uid) || admin(); allow write: if false; }
    match /paymentOrders/{id} { allow read: if owner(resource.data.uid) || admin(); allow write: if false; }
    match /payments/{id} { allow read: if owner(resource.data.uid) || admin(); allow write: if false; }
    match /dailyStats/{id} { allow read: if owner(resource.data.uid) || admin(); allow write: if false; }
    match /waitlist/{email} {
      allow read: if admin();
      allow create, update: if request.auth != null && request.auth.token.email == email;
      allow delete: if false;
    }
    match /categories/{id} { allow read: if true; allow write: if false; }
    // Feedback is accepted by the server API only; no client can list or edit messages.
    match /feedback/{id} { allow read, write: if false; }
    // Uploads, review receipts, rate limits and audit logs are server-only.
  }
}
