rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users — authenticated users read all, write only own profile
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Ads — anyone can read active ads (leaderboard); owner manages own ads
    match /ads/{adId} {
      allow read: if true;
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid == resource.data.advertiserUID;
      allow delete: if request.auth != null && request.auth.uid == resource.data.advertiserUID;
    }

    // Transactions — only owner can read; Admin SDK writes (no client writes)
    match /transactions/{txId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid;
      allow write: if false;
    }

    // Categories — public read, no client writes
    match /categories/{catId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
