rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users — authenticated users read all, write only own profile
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Ads — anyone can read active ads, owner can create/update/delete own ads
    match /ads/{adId} {
      allow read: if true;
      // Create: authenticated user, must set own UID, start as pending, zero paid
      allow create: if request.auth != null
        && request.resource.data.advertiserUID == request.auth.uid
        && request.resource.data.status == "pending"
        && request.resource.data.totalPaidCents == 0
        && request.resource.data.moderationPassed == true;
      // Update: owner only, server-controlled fields are immutable from client
      allow update: if request.auth != null
        && request.auth.uid == resource.data.advertiserUID
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
             "status", "expiresAt", "startsAt",
             "totalPaidCents", "dailyBidCents",
             "moderationPassed", "advertiserUID",
             "impressions", "clicks",
             "pendingPaymentId", "externalTxId", "paymentMethod"
           ]);
      // Delete: owner only
      allow delete: if request.auth != null
        && request.auth.uid == resource.data.advertiserUID;
    }

    // Transactions — owner can read own, no client writes
    match /transactions/{txId} {
      allow read: if request.auth != null
        && request.auth.uid == resource.data.uid;
      allow write: if false;
    }

    // Waitlist — authenticated user can write own entry only
    match /waitlist/{email} {
      allow read: if false;
      allow create, update: if request.auth != null;
      allow delete: if false;
    }

    // Payments — only owner can read, no client writes
    match /payments/{paymentId} {
      allow read: if request.auth != null
        && request.auth.uid == resource.data.uid;
      allow write: if false;
    }

    // Categories — public read, no client writes
    match /categories/{catId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
