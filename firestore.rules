rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Users — each user reads and writes only their own profile; spend is server-managed
    match /users/{userId} {
      allow read: if signedIn() && request.auth.uid == userId;
      // Create: resource is null here, so spend is checked on the new document itself
      allow create: if signedIn()
        && request.auth.uid == userId
        && (!("totalSpentCents" in request.resource.data) || request.resource.data.totalSpentCents == 0);
      allow update: if signedIn()
        && request.auth.uid == userId
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
             "totalSpentCents", "isNewAccount"
           ]);
      allow delete: if false;
    }

    // Ads — the public sees only running ads; owners see all of theirs.
    // Create and edit go through /api/ads/* (AI moderation is enforced there),
    // status/payment fields only through the payment routes, so no client writes.
    match /ads/{adId} {
      // resource == null: reading a deleted/missing ad just returns "not found"
      allow read: if resource == null
        || resource.data.status == "active"
        || (signedIn() && request.auth.uid == resource.data.advertiserUID);
      allow create, update: if false;
      // Only unpaid ads can be deleted (same as the dashboard offers)
      allow delete: if signedIn()
        && request.auth.uid == resource.data.advertiserUID
        && resource.data.status in ["pending", "rejected"];

      // Per-day view/click counters for the dashboard chart — owner reads, server writes
      match /daily/{day} {
        allow read: if signedIn()
          && get(/databases/$(database)/documents/ads/$(adId)).data.advertiserUID == request.auth.uid;
        allow write: if false;
      }
    }

    // Moderation approvals — server only
    match /moderations/{id} {
      allow read, write: if false;
    }

    // Transactions — owner can read own, no client writes
    match /transactions/{txId} {
      allow read: if request.auth != null
        && request.auth.uid == resource.data.uid;
      allow write: if false;
    }

    // Waitlist — authenticated user can write own entry only (doc id is their e-mail)
    match /waitlist/{email} {
      allow read: if false;
      allow create, update: if signedIn()
        && request.auth.token.email != null
        && request.auth.token.email.lower() == email.lower();
      allow delete: if false;
    }

    // Payments — only owner can read, no client writes
    match /payments/{paymentId} {
      allow read: if request.auth != null
        && request.auth.uid == resource.data.uid;
      allow write: if false;
    }

    // Categories — public read, no client writes
    match /categories/{catId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
